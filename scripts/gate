#!/usr/bin/env bash
# The gate contract of a pitwall project.
#
#   scripts/gate --fast      format (whitespace), build, unit tests: the inner loop,
#                            which .githooks/pre-commit runs before every commit
#   scripts/gate --changed   the full checks when code changed since main, and the
#                            self-test when a guard changed (see guard_changed below)
#   scripts/gate --full      everything CI runs: restore, dotnet format, build, tests,
#                            and scripts/gate-selftest
#
# Exit 0 is a pass, anything else is a fail. pitwall never assumes a stack: its
# skills and hooks only call this script. The build treats every warning as an
# error (Directory.Build.props), which is also how the architecture boundaries in
# CLAUDE.md fail the build.
set -euo pipefail

mode="${1:---full}"
case "$mode" in
  --fast|--changed|--full) ;;
  *) echo "usage: scripts/gate [--fast|--changed|--full]" >&2; exit 2 ;;
esac

if ! top="$(git rev-parse --show-toplevel 2>/dev/null)"; then
  echo "gate: FAIL - not inside a git repository."
  exit 1
fi
cd "$top"

if ! command -v dotnet >/dev/null 2>&1; then
  echo "gate: FAIL - dotnet is not on PATH; install the .NET SDK that global.json names."
  exit 1
fi

export DOTNET_NOLOGO=1
export DOTNET_CLI_TELEMETRY_OPTOUT=1
export DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1

solution="MoveReminder.sln"

# Runs one check and stops the gate at the first one that fails.
step() {
  local name="$1"
  shift
  echo "gate: $name"
  if ! "$@"; then
    echo "gate: FAIL ($mode) - $name"
    exit 1
  fi
}

fast_checks() {
  step "format (whitespace)" dotnet format whitespace "$solution" --verify-no-changes
  step "build (warnings as errors)" dotnet build "$solution" -c Release --nologo -v q
  step "tests" dotnet test --solution "$solution" -c Release --no-build
}

full_checks() {
  step "restore" dotnet restore "$solution" --nologo -v q
  step "format (whitespace, style, analyzers)" dotnet format "$solution" --verify-no-changes --no-restore
  step "build (warnings as errors)" dotnet build "$solution" -c Release --no-restore --nologo -v q
  step "tests" dotnet test --solution "$solution" -c Release --no-build
}

# Files that are not code: a change to them alone needs no checks.
is_docs() {
  case "$1" in
    docs/*|*.md|LICENSE|.claude/*.json) return 0 ;;
  esac
  return 1
}

# Files that hold a guard the self-test proves: the gate, the build settings, the banned APIs.
is_guard() {
  case "$1" in
    scripts/gate|scripts/gate-selftest|.githooks/*) return 0 ;;
    global.json|nuget.config|.editorconfig|*.props|*.targets|*.csproj|*.sln) return 0 ;;
    */BannedSymbols*.txt) return 0 ;;
  esac
  return 1
}

case "$mode" in
  --fast)
    fast_checks
    ;;
  --full)
    full_checks
    step "self-test (the gate and the build guards fail when they should)" bash scripts/gate-selftest
    ;;
  --changed)
    base="$(git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main 2>/dev/null || true)"
    if [ -z "$base" ]; then
      echo "gate: no main to compare with, so every check runs."
      full_checks
      step "self-test (the gate and the build guards fail when they should)" bash scripts/gate-selftest
    else
      code=0
      guard=0
      while IFS= read -r f; do
        [ -n "$f" ] || continue
        is_docs "$f" || code=1
        if is_guard "$f"; then guard=1; fi
      done < <(git -c core.quotePath=false diff --name-only "$base"; git -c core.quotePath=false ls-files --others --exclude-standard)
      if [ "$code" = 0 ]; then
        echo "gate: PASS ($mode) - only docs changed since main."
        exit 0
      fi
      full_checks
      if [ "$guard" = 1 ]; then
        step "self-test (the gate and the build guards fail when they should)" bash scripts/gate-selftest
      fi
    fi
    ;;
esac

echo "gate: PASS ($mode)"
