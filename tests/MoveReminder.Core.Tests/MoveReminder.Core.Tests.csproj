<Project Sdk="Microsoft.NET.Sdk">

  <!-- References Core only, never App: Core's tests run without Windows UI (CLAUDE.md, Architecture boundaries). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>MoveReminder.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MoveReminder.Core\MoveReminder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's icon as a file, so AppIconFileTests can read its frames; a copy, not a reference to App. -->
    <None Include="..\..\src\MoveReminder.App\Resources\move-reminder.ico" Link="move-reminder.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
